root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,cjs,mjs,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 3

[*.{c,cc,cpp,cxx,h,hpp}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
